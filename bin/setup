#!/bin/bash

set -e

echo "🚀 Affilify Magento 2 Development Environment Setup"
echo "=================================================="

# Colori per output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Verifica se Docker è in esecuzione
if ! docker info > /dev/null 2>&1; then
    echo -e "${RED}❌ Docker non è in esecuzione. Avvia Docker e riprova.${NC}"
    exit 1
fi

# Crea la directory src se non esiste
if [ ! -d "src" ]; then
    mkdir -p src
fi

# Verifica le credenziali Magento
if [ ! -f "auth.json" ]; then
    echo -e "${YELLOW}⚠️  File auth.json non trovato.${NC}"
    echo ""
    echo "Per scaricare Magento hai bisogno delle credenziali da:"
    echo "https://marketplace.magento.com/customer/accessKeys/"
    echo ""
    read -p "Inserisci la tua Public Key: " PUBLIC_KEY
    read -p "Inserisci la tua Private Key: " PRIVATE_KEY
    
    cat > auth.json << EOF
{
    "http-basic": {
        "repo.magento.com": {
            "username": "${PUBLIC_KEY}",
            "password": "${PRIVATE_KEY}"
        }
    }
}
EOF
    echo -e "${GREEN}✅ auth.json creato${NC}"
fi

echo ""
echo "📦 Avvio dei container Docker..."
docker-compose up -d

echo ""
echo "⏳ Attendo che i servizi siano pronti..."
sleep 10

# Verifica che il database sia pronto
echo "🔍 Verifico connessione al database..."
for i in {1..30}; do
    if docker-compose exec -T db mysqladmin ping -h localhost -u magento -pmagento --silent 2>/dev/null; then
        echo -e "${GREEN}✅ Database pronto${NC}"
        break
    fi
    echo "   Attendo il database... ($i/30)"
    sleep 2
done

# Verifica che Elasticsearch sia pronto
echo "🔍 Verifico OpenSearch..."
until curl -s http://localhost:9200/_cluster/health > /dev/null 2>&1; do
    echo "   Attendo OpenSearch..."
    sleep 5
done
echo -e "${GREEN}✅ OpenSearch pronto${NC}"

# Scarica Magento se src è vuota
if [ ! -f "src/composer.json" ]; then
    echo ""
    echo "📥 Download di Magento 2.4.7..."
    
    # Copia auth.json nella directory home del container e crea la directory .composer
    docker-compose exec -T -u root php mkdir -p /var/www/.composer
    docker-compose exec -T -u root php chown -R www:www /var/www/.composer
    docker cp auth.json $(docker-compose ps -q php):/var/www/.composer/auth.json
    docker-compose exec -T -u root php chown www:www /var/www/.composer/auth.json
    
    # Imposta permessi sulla directory di lavoro
    docker-compose exec -T -u root php chown -R www:www /var/www/html
    
    docker-compose exec -T php composer create-project \
        --repository-url=https://repo.magento.com/ \
        magento/project-community-edition=2.4.7 \
        /tmp/magento
    
    docker-compose exec -T -u root php cp -r /tmp/magento/. /var/www/html/
    docker-compose exec -T -u root php rm -rf /tmp/magento
    docker-compose exec -T -u root php chown -R www:www /var/www/html
    
    echo -e "${GREEN}✅ Magento scaricato${NC}"
fi

# Installa Magento
if [ ! -f "src/app/etc/env.php" ]; then
    echo ""
    echo "🔧 Installazione di Magento..."
    
    docker-compose exec -T php bin/magento setup:install \
        --base-url=http://localhost \
        --db-host=db \
        --db-name=magento \
        --db-user=magento \
        --db-password=magento \
        --admin-firstname=Admin \
        --admin-lastname=User \
        --admin-email=admin@example.com \
        --admin-user=admin \
        --admin-password=Admin123! \
        --language=it_IT \
        --currency=EUR \
        --timezone=Europe/Rome \
        --use-rewrites=1 \
        --search-engine=opensearch \
        --opensearch-host=opensearch \
        --opensearch-port=9200 \
        --amqp-host=rabbitmq \
        --amqp-port=5672 \
        --amqp-user=magento \
        --amqp-password=magento \
        --amqp-virtualhost=/
    
    echo -e "${GREEN}✅ Magento installato${NC}"
fi

# Configura per lo sviluppo
echo ""
echo "⚙️  Configurazione modalità sviluppo..."
docker-compose exec -T php bin/magento deploy:mode:set developer
docker-compose exec -T php bin/magento config:set web/secure/use_in_frontend 0
docker-compose exec -T php bin/magento config:set web/secure/use_in_adminhtml 0

# Abilita il modulo Affilify
echo ""
echo "📦 Abilitazione modulo Affilify_Tracking..."
docker-compose exec -T php bin/magento module:enable Affilify_Tracking
docker-compose exec -T php bin/magento setup:upgrade
docker-compose exec -T php bin/magento setup:di:compile
docker-compose exec -T php bin/magento cache:flush

# Disabilita 2FA per sviluppo
echo ""
echo "🔓 Disabilito 2FA per sviluppo..."
docker-compose exec -T php bin/magento module:disable Magento_AdminAdobeImsTwoFactorAuth Magento_TwoFactorAuth || true
docker-compose exec -T php bin/magento setup:upgrade
docker-compose exec -T php bin/magento cache:flush

# Imposta permessi
docker-compose exec -T php chmod -R 777 var generated pub/static

echo ""
echo -e "${GREEN}=================================================="
echo "✅ Setup completato!"
echo "==================================================${NC}"
echo ""
echo "🌐 Frontend:     http://localhost"
echo "🔧 Admin Panel:  http://localhost/admin"
echo "   Username:     admin"
echo "   Password:     Admin123!"
echo ""
echo "📧 Mailhog:      http://localhost:8025"
echo "🐰 RabbitMQ:     http://localhost:15672 (magento/magento)"
echo "🔍 Elasticsearch: http://localhost:9200"
echo ""
echo "📝 Log Affilify: docker-compose exec php tail -f var/log/affilify_tracking.log"
echo ""
echo "🛑 Per fermare:  docker-compose down"
echo "🚀 Per avviare:  docker-compose up -d"
