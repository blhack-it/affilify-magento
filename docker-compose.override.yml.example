# Docker Compose Override Example
# Copy this file to docker-compose.override.yml and customize for your local environment
# This file is ignored by git

services:
  # PHP service customizations
  php:
    environment:
      # Enable Xdebug for local development
      XDEBUG_MODE: debug
      XDEBUG_CONFIG: client_host=host.docker.internal
      # PHP development settings
      PHP_IDE_CONFIG: serverName=magento
    # Mount additional local configs
    # volumes:
    #   - ./docker/php/xdebug.ini:/usr/local/etc/php/conf.d/xdebug.ini:ro

  # Database customizations
  db:
    # Expose database port only in development
    ports:
      - "3306:3306"

  # Mock API for testing (optional - uncomment if needed)
  # mock-api:
  #   environment:
  #     DEBUG: "true"
  #     LOG_LEVEL: verbose

  # Redis (optional port exposure)
  redis:
    ports:
      - "6379:6379"

  # Uncomment to enable phpMyAdmin for database management
  # phpmyadmin:
  #   image: phpmyadmin:5
  #   ports:
  #     - "8080:80"
  #   environment:
  #     PMA_HOST: db
  #     PMA_USER: magento
  #     PMA_PASSWORD: magento
  #   depends_on:
  #     - db
  #   networks:
  #     - magento
