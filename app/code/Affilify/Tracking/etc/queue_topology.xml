<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/topology.xsd">
    <exchange name="affilify.tracking" type="topic" connection="db">
        <binding id="affilifyTrackingClickBinding" topic="affilify.tracking.click" destinationType="queue" destination="affilify.tracking.click"/>
        <binding id="affilifyTrackingConversionBinding" topic="affilify.tracking.conversion" destinationType="queue" destination="affilify.tracking.conversion"/>
    </exchange>
</config>
